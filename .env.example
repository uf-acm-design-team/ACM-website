# Copy this file to .env.local and fill in any values you need.

# UF ACM public Google Calendar, for the /calendar page integration.
# NEXT_PUBLIC_ variables are exposed to the browser, which is fine for a public calendar.
# Embed URL: https://calendar.google.com/calendar/embed?src=<ID>&ctz=<TIMEZONE>
NEXT_PUBLIC_GOOGLE_CALENDAR_ID=fb2d1622610fc3a0b7d002c79f5093f4ca701f498584ad1b98bde4227be6e83c@group.calendar.google.com
NEXT_PUBLIC_GOOGLE_CALENDAR_TIMEZONE=America/New_York
